#!/usr/bin/env bash
# Single-command GUI entry for System Updater: sleep-inhibited terminal + update-all.sh
# Portable terminal choice: first available wins.
# Find update-all.sh next to this script first: that covers both the
# user install (~/.local/bin) and package installs (/usr/bin), where the
# old hardcoded ~/.local/bin path pointed at nothing.
SELF=$(command -v -- "$0" 2>/dev/null || printf '%s' "$0")
SELF_DIR=$(cd "$(dirname "$SELF")" && pwd)
BIN=""
for cand in "$SELF_DIR/update-all.sh" "$HOME/.local/bin/update-all.sh" \
            "$(command -v update-all.sh 2>/dev/null || true)"; do
  if [ -n "$cand" ] && [ -x "$cand" ]; then BIN="$cand"; break; fi
done
if [ -z "$BIN" ]; then
  echo "update-all.sh not found next to $SELF or on PATH - run install.sh first." >&2
  exit 1
fi
# run under systemd-inhibit when available; exec directly otherwise
run() {
  if command -v systemd-inhibit >/dev/null 2>&1; then
    exec systemd-inhibit --what=sleep --why="system update" "$@"
  fi
  exec "$@"
}
# Generic terminal choice: the freedesktop helper, then the user's own
# $TERMINAL, then the desktop's configured default, then a neutral fallback.
# Nothing here assumes a particular machine's setup.
desktop_term() {
  local app=""
  if command -v kreadconfig6 >/dev/null 2>&1; then
    app=$(kreadconfig6 --file kdeglobals --group General --key TerminalApplication 2>/dev/null)
  elif command -v kreadconfig5 >/dev/null 2>&1; then
    app=$(kreadconfig5 --file kdeglobals --group General --key TerminalApplication 2>/dev/null)
  fi
  if [ -z "$app" ] && command -v gsettings >/dev/null 2>&1; then
    app=$(gsettings get org.gnome.desktop.default-applications.terminal exec 2>/dev/null | tr -d "'")
  fi
  printf '%s' "$app"
}
term_flag() {
  case "$(basename "$1")" in
    gnome-terminal) printf '%s' '--' ;;
    xfce4-terminal) printf '%s' '-x' ;;
    wezterm) printf '%s' 'start --' ;;
    foot|blackbox-terminal) printf '%s' '' ;;
    *) printf '%s' '-e' ;;
  esac
}
pick_term() {
  local app="" name=""
  if command -v xdg-terminal-exec >/dev/null 2>&1; then echo "xdg-terminal-exec"; return; fi
  if [ -n "${TERMINAL:-}" ] && command -v "${TERMINAL%% *}" >/dev/null 2>&1; then app="$TERMINAL"; fi
  [ -n "$app" ] || app=$(desktop_term)
  if [ -n "$app" ]; then
    name=$(basename "${app%% *}")
    echo "$name $(term_flag "$name")"
    return
  fi
  for t in alacritty foot ghostty kitty konsole qterminal tilix wezterm xfce4-terminal gnome-terminal xterm; do
    command -v "$t" >/dev/null 2>&1 || continue
    echo "$t $(term_flag "$t")"
    return
  done
  echo ""
}
if [ -t 1 ]; then
  # already in a terminal: just run it
  run "$BIN" "$@"
fi
TERM_CMD=$(pick_term)
if [ -z "$TERM_CMD" ]; then
  echo "No terminal found (install xdg-terminal-exec, or set \$TERMINAL)." >&2
  exit 1
fi
# shellcheck disable=SC2086
run $TERM_CMD "$BIN" "$@"
