# Maintainer: Maidware <maidwareproject@proton.me>
pkgname=maid-au-git
pkgver=0.1.r1.g0000000
pkgrel=1
pkgdesc="One updater for everything on Linux (native, flatpak, firmware, snapshots first)"
arch=('x86_64' 'aarch64')
url="https://github.com/Maidware-Project/Maid-AU"
license=('MIT')
depends=('flatpak' 'fwupd' 'libnotify' 'pacman-contrib' 'qt6-base')
makedepends=('git' 'cmake' 'qt6-base')
provides=('maid-au')
conflicts=('maid-au')
source=("git+https://github.com/Maidware-Project/Maid-AU.git")
sha256sums=('SKIP')

pkgver() {
  cd "Maid-AU"
  printf "0.1.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
  cd "Maid-AU"
  DESTDIR="$pkgdir" bash install.sh --prefix=/usr --no-packages --no-config
}
