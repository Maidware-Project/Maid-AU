+    // kdeconnectd can be D-Bus activated very early during login, before the
+    // session environment (XDG_SESSION_TYPE, WAYLAND_DISPLAY, DISPLAY) has
+    // been propagated to the systemd user instance. If the platform is then
+    // left unspecified, Qt's own detection may pick xcb because DISPLAY is
+    // set, even though Xwayland is not accepting connections yet. Failing to
+    // initialize a platform plugin is fatal and aborts the daemon, so always
+    // specify an ordered list of platforms to try instead.
+    // On Windows and macOS the platform plugin names are different, leave
+    // their platform detection alone.
+#if !defined(Q_OS_WIN) && !defined(Q_OS_MACOS)
     const QByteArray sessionType = qgetenv("XDG_SESSION_TYPE");
-    if (sessionType.isEmpty()) {
-        return;
+
+    // Without WAYLAND_DISPLAY, Qt cannot find the compositor even if it is
+    // already accepting connections. Look for its socket in the runtime
+    // directory.
+    if (qEnvironmentVariableIsEmpty("WAYLAND_DISPLAY")) {
+        const QString runtimeDir = QString::fromLocal8Bit(qgetenv("XDG_RUNTIME_DIR"));
+        if (!runtimeDir.isEmpty()) {
+            const QFileInfoList sockets = QDir(runtimeDir).entryInfoList({QStringLiteral("wayland-*")}, QDir::Files | QDir::System);
+            for (const QFileInfo &socket : sockets) {
+                if (socket.exists() && !socket.isFile() && !socket.isDir()) {
+                    qputenv("WAYLAND_DISPLAY", socket.fileName().toLocal8Bit());
+                    break;
+                }
+            }
+        }
     }
-    if (qstrcmp(sessionType.constData(), "wayland") == 0) {
-        qputenv("QT_QPA_PLATFORM", "wayland");
-    } else if (qstrcmp(sessionType.constData(), "x11") == 0) {
-        qputenv("QT_QPA_PLATFORM", "xcb");
+
+    // Prefer the platform which matches the session, then try the other
+    // display server, and finally fall back to a headless platform so that
+    // the daemon can always start.
+    const bool preferXcb = sessionType == QByteArrayLiteral("x11")
+        || (sessionType != QByteArrayLiteral("wayland") && qEnvironmentVariableIsEmpty("WAYLAND_DISPLAY") && !qEnvironmentVariableIsEmpty("DISPLAY"));
+    if (preferXcb) {
+        qputenv("QT_QPA_PLATFORM", QByteArrayLiteral("xcb;wayland;offscreen"));
+    } else {
+        qputenv("QT_QPA_PLATFORM", QByteArrayLiteral("wayland;xcb;offscreen"));
     }
+#endif
 }
 
